  "files": {
    "372e0cacda9be5f4a8d47158b14065c4df4cedfaa94fad3da988ae146e50fe72.wav": {
      "text": "A mysterious illness spread through the village.",
      "sha256": "f45b03100039404fc8a75134bdd4fc55a04f988e17ee8776ff08e14aeeb1a097"
    },
    "850fdc4c90b6a12f11e94673998e8c001e33f52be0f49749956d6a64bbf8477c.wav": {
      "text": "A stranger stopped me to ask for directions.",
      "sha256": "0f9b069cdae3aac7cc025c2d88292f310d2d89bf688e00bc0b8741b3cdf63eee"
    },
    "c83feca444fce17cd779e57ead1bd26371efe13b1ab888951ea6c1f6ea2d58c2.wav": {
      "text": "After weeks without work, he was desperate for money.",
      "sha256": "88b66c0ba5b3f1142a7078c1141beaace1109232e745e26d43a8b40565def265"
    },
    "91afe6e6f893e20ae52c9cb8367f1a3b7574772f7349fc388e5d5b9be536c8ec.wav": {
      "text": "Be careful not to tear the paper.",
      "sha256": "653b967c64b4e497cd36cf40611707e4601c7409b598ddf46f474ef5273deb8d"
    },
    "c36c8f816f4801335bd0aaaa35272c22c2e14473194a4e430f4a8e08f0d91f86.wav": {
      "text": "Call the police if you see anything suspicious.",
      "sha256": "730b1652ddd9eabaa13b2a960192cd9f6ab50381df5ce5ba6213df791ccbd855"
    },
    "6554160caaefc9c1870b5993c953d45f78cc52f82f1cee2816c3f85b186dd6c4.wav": {
      "text": "Clean the brush before the paint dries.",
      "sha256": "7aca7821669c9f22c4003abca81ec2619a40961261e75b41a8d37aa16158eba9"
    },
    "f98695f548f589696ec0422d357e42d3ece72205462aaa17a1913a45128d296c.wav": {
      "text": "Don't hesitate to contact me if you have any questions.",
      "sha256": "ba517cc759555f453527ed054cb8d21b97c9c3ba7ed7b8f8cefb99e385a6e003"
    },
    "3a78e3434a3ae145d73bf79b2866d19b6744db243b8a70b660964b48dde85cef.wav": {
      "text": "Experts warn that sea levels will continue to rise.",
      "sha256": "5639c9aa6f02e8f17b84dd8a750abb7a929fa9904ae89f69ea3eec93ea0a4df0"
    },
    "a9e6c5fbddb3bfc131e779883194bd96f0b6b9c61a4d498d2da6ae0bd5373a81.wav": {
      "text": "Grief can affect both the mind and the body.",
      "sha256": "816b7d2f6a209e1e46175de3ec192b2fc693685448c47cf19353f972a5fcdcef"
    },
    "ec25ba0e90fbcd65a2ccd13a9dbd32fa1035b87ee59b59feeb897e3da9d33690.wav": {
      "text": "He carried a bundle of old letters under his arm.",
      "sha256": "34660581b4c550afed39ab559368adbdd79d3dc254011820f7953b06674a3dee"
    },
    "b8e1515170122a51a5c3b31f4b02a756b3300e78ecb6c1c5c841265fb8e65bc9.wav": {
      "text": "He had to beg his parents for a second chance.",
      "sha256": "a3ca1723e39fa98b0ef49cb7d4571c69c134cf6e7a92368d5cc3a97bb4265c4a"
    },
    "e2109609b54615c97f3628879a82b45c4a2d139f9704f55501f4a6cb07dcc6f6.wav": {
      "text": "He wore a hat and glasses as a disguise.",
      "sha256": "bdd01d2317616dac65893eb5418e09dfe393aa28dbd64344b3ad135d65f22066"
    },
    "75f2b3793ecc15de0eea3c40f8c59dda5bc09e7bd06aefa55b9c9b0e8f15292f.wav": {
      "text": "Her hands began to tremble as she opened the letter.",
      "sha256": "076df5a885637c20e43afce6f7df4ffc404fb30b51c2a7eba530a8799151ced9"
    },
    "a26744e06a2b83160e5d5f652a186ed2efb96b188036502d919f48e2332b8bde.wav": {
      "text": "It is hard to resist the temptation to check your phone.",
      "sha256": "42298c5308c02d358838d0c4f745442604fd2f8bdfb16bb8b8a9019985f44483"
    },
    "21a5f00c435c1011eda8461114827ad310bc50709aadf9cd4a9d58c89163109f.wav": {
      "text": "My only regret is that I didn't start earlier.",
      "sha256": "8dedc53050a8c37f646a9c5cf1510377cf92e2b0db41fea85c6b3b9e836aba64"
    },
    "de0dbc10a80a904d86b53aa4f3eba4c0562fa8043c4cb265d27299abb3637ca5.wav": {
      "text": "Police managed to capture the suspect near the border.",
      "sha256": "4f96765ad457a786e9555dee8a5a64f6906ddff90c0a036a6336edc74f1b6adc"
    },
    "58251497ddffe0233b21da4a719d6cbe364ac1d909ec4ffc694ef0623064a0f3.wav": {
      "text": "She is a respected scholar of Chinese history.",
      "sha256": "e9b063c801c5f82e4c8f68671ce7da046975e66a8fd78b70a01776a643533e21"
    },
    "9d83ad86383e6670475270b868e1755636ddc0083c21f2806d279267422e554d.wav": {
      "text": "She peeked at the last page of the novel.",
      "sha256": "fa4d420b0b451adb0e939694260256671cf102ae93ddeeafc91cae232fa25ff4"
    },
    "4bd6a95c3e9f156b2e1a29c67b708fbf6f852b39fc6324e8bcfeaa549718c7a2.wav": {
      "text": "She tried to conceal her disappointment.",
      "sha256": "0ba70fcfcab12513a0464cecfe80e53109d2cb17ad5cd96c56bfffbffc5e75fa"
    },
    "67b673ad704881fb696764c7e1944126b0924cb6eb172ca7271aca81eb3d59f4.wav": {
      "text": "Success often requires personal sacrifice.",
      "sha256": "6fefe171b8c0a323d43b05ccd8037d6b6f946e44ac0153ee6cac3fc146d31537"
    },
    "35fbae16108122b59ad213a7e495e8717dd6fb1a52f7e5ecf62e280120f17563.wav": {
      "text": "The advertisement was designed to deceive customers.",
      "sha256": "0f279c17f21598884c4ed528b88f551934b62d6701534fca96feb3038f7f21c7"
    },
    "281353af82f677bf36ee3ca14b94eed1ce2f1b71f07b22579cc5cb675f515faf.wav": {
      "text": "The charity provides shelter for homeless families.",
      "sha256": "becee0ce52f725f4cd75d0d25ef770d9fd2476aa648eace4fdc47ecf0f9b2d69"
    },
    "75d82d3dad8d5d97d9fb4c2d02467652a267587df1e7ee69da778ce5913e59c1.wav": {
      "text": "The children drew a monster with three eyes.",
      "sha256": "15d9da2fa49151cb9906b1f4f3fe2e924210b62855070356dcaf98bd7ef42b29"
    },
    "76d6d505719cc64ad8b2b1381de9c9925f008561fea8ad70cdf91a622cc3d7de.wav": {
      "text": "The detective examined the corpse for clues.",
      "sha256": "06d8f24b8459929eb77d69c344fb70db514196909ca7a2920b16b7fc4b812305"
    },
    "a9d3dbf6ff40f1fb9881baa5d49c571119cdacd31f4e17e41359e43ce449708b.wav": {
      "text": "The film is a simple story of good against evil.",
      "sha256": "45acc06830edde0ba7b3d3fd710a85a83ecb1eb4de1a725b7c36bd64bf8440de"
    },
    "7afef3a81942e256222abdc6d87ea0518c76a089b3e39c4c8feb3f090b0089e7.wav": {
      "text": "The government hopes to revive the local economy.",
      "sha256": "11162c91d3b9369e3a3348ae6691b696f2065b90e3ee45423c23f775a6b918b8"
    },
    "64cda6c5e890b9ca8d3d24501819fb76fbdbe0faec2db044ba8bba288442d73a.wav": {
      "text": "The manager tried to humiliate him in front of his colleagues.",
      "sha256": "18a8e935f6c357929cea484c93ed6950264f5958317f0bf92e4b5476b8eb8efc"
    },
    "9caff51c421e0247cd2ac483c0eb2c031c096dd2f53742e1dcf5b55507fda3c6.wav": {
      "text": "The museum displays a sword from the Ming dynasty.",
      "sha256": "5fe10ece1144bb05bae387582938835e37eee39049d6c97c39c3021906729388"
    },
    "e9bb3335adb50ac20d3e85d54a34e2ee589de9b6668d4fef2cf47948526e53a6.wav": {
      "text": "The plane seemed to vanish from the radar.",
      "sha256": "072ecbbe70f03ed7bbd41df7750cc67e303f5acb49a980c8b8c7b7024b820647"
    },
    "f9501811858e61ca2a184fb442026cf18b2a08e6d7be2572afd558703c87d657.wav": {
      "text": "The two companies are in fierce competition.",
      "sha256": "68d869c47e4b5d78dc4288a440734d5225775ea4543a0379e60c10af88f9c2e9"
    },
    "0bb80e0cf0f3b152d95a01d54d1b6bdd38a84fe15bbb2cccd3704d9510c7e0ff.wav": {
      "text": "Thousands of people had to flee the flood.",
      "sha256": "a08b8336eb4d86ef50fc1348596c961e48f3e68e555320157fa92f245961bab7"
    },
    "cfc900887a2e57d7555c5dd985640561761d8912df8888e4ccee14867ce115c7.wav": {
      "text": "We left the hotel at dawn to avoid the traffic.",
