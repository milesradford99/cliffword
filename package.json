{
  "name": "cliffword",
  "version": "0.0.0",
  "private": true,
  "description": "Original Chinese stories with English target words woven in, plus recall exercises and next-day review.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "validate": "node scripts/validate-content.mjs",
    "validate:library": "node scripts/validate-content.mjs library --library",
    "import": "node scripts/import-text.mjs",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "words": "node scripts/words.mjs",
    "audio": "node scripts/generate-audio.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
